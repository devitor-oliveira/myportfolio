---
import { Icon } from "astro-icon/components";

import AboutLayout from "@/layouts/AboutLayout.astro";
import AboutExperiences from "@/components/AboutExperiences";
import AboutCommentsForm from "@/components/AboutCommentsForm";
import AboutCommentsSection from "@/components/AboutCommentsSection";

import type { CommentsApiResponse } from "@/hooks/useGetComments";

// Fetch em build pra evitar layout shift
// Melhorar entrega de comentários pré-existentes
// Migrar para API ROUTE
const URL = import.meta.env.PUBLIC_GET_COMMENTS_WEBHOOK_URL;

let initialComments: CommentsApiResponse;

try {
	const res = await fetch(`${URL}?action=list`, {
		method: "GET",
		headers: {
			Accept: "application/json",
		},
	});
	if (!res.ok) throw new Error(`Failed: ${res.status}`);
	initialComments = await res.json();
} catch (e) {
	initialComments = { total: 0, comments: [] };
	console.error("Falha na busca de comentários", e);
}
---

<AboutLayout>
	<header class="relative flex justify-between items-center">
		<nav class="absolute -top-12 -left-2 md:-left-18 md:top-0">
			<a href="/"
				><Icon name="mdi:chevron-left" class="w-8 h-8 md:w-8 md:h-8" /></a
			>
		</nav>
		<h1 class="font-display text-h3 text-text-main">Sobre mim</h1>
		<a href="" class="text-caption text-text-main/85 font-detail">Currículo</a>
	</header>
	<main class="flex flex-col gap-8 h-full w-full mt-6">
		<section class="w-full flex flex-col gap-4">
			<p class="text-justify text-body text-text-main/90">
				Sou Desenvolvedor Fullstack graduado em Análise e Desenvolvimento de
				Sistemas, com foco em transformar problemas complexos em interfaces
				performáticas e sistemas resilientes. Minha jornada iniciou-se aos 13
				anos com lógica de programação em Python e expandiu-se com a fundação de
				uma comunidade de tecnologia focada em aprendizado contínuo.
			</p>
			<p class="text-justify text-body text-text-main/90">
				Atuei em equipe de Transformação Digital, sendo responsável pela
				arquitetura e integração da API do Pix Automático do Banco do Brasil,
				criação de automações com N8N e estruturação de bancos de dados com
				Supabase. Busco constantemente unir desenvolvimento web moderno
				(Next.js/Node.js), automação de processos e IA para entregar soluções de
				software que geram valor real.
			</p>
		</section>
		<section class="w-full">
			<h2 class="md:text-[20px] text-text-main font-display mb-2">
				Experiência
			</h2>
			<AboutExperiences client:load />

			<div class="flex flex-col gap-4 mt-6">
				<AboutCommentsForm
					title="Me conhece ou trabalhou comigo? Deixe um comentário..."
					client:load
				/>
				<hr class="border-border-muted-alt/60 mb-3 mt-3" />
				<AboutCommentsSection initialData={initialComments} client:load />
			</div>
		</section>
	</main>
	<footer class="mt-16">
		<div class="w-full">
			<hr class="border-border-muted-alt my-6 md:my-8" />
			<div
				class="flex flex-col gap-3 items-center md:flex-row md:items-center md:justify-between font-detail text-caption text-on-surface-variant"
			>
				<p class="shrink-0">© 2026 • Vitor Hugo</p>

				<a
					href="mailto:contato.dev@gmail.com"
					class="break-all transition-colors hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm"
				>
					contato.dev@gmail.com
				</a>

				<p class="flex items-center gap-2 shrink-0">
					<a
						href="/termos"
						class="transition-colors hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm"
					>
						Termos
					</a>
					<span aria-hidden="true" class="text-on-surface-variant/60">•</span>
					<a
						href="/privacidade"
						class="transition-colors hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm"
					>
						Privacidade
					</a>
				</p>
			</div>
		</div>
	</footer>
</AboutLayout>
