---
import BlogList from "@/components/BlogList/BlogList.astro";
import ContentClient from "@/components/ContentClient";
import HeroCard from "../components/Card/HeroCard.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import TerminalHero from "@/components/TerminalHero";
import HeroContentWrapper from "@/components/HeroContentWrapper";
import { heroCardContent } from "@/lib/siteContent";

const blogPosts = await getCollection("blog");
const sortedPosts = blogPosts.sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latestPost = sortedPosts[0].id;

const { title, description, socials, techstack } = heroCardContent;
---

<Layout>
	<main class="flex items-center flex-col h-full w-full">
		<!-- Hero -->
		<section class="flex-center h-full w-full max-w-7xl">
			<HeroContentWrapper client:load>
				<HeroCard
					slot="CardHeroSlot"
					title={title}
					description={description}
					socials={socials}
					techstack={techstack}
				/>

				<TerminalHero slot="TerminalSlot" lastPostID={latestPost} client:load />
			</HeroContentWrapper>
		</section>

		<!-- Content Section -->
		<section class="flex-center max-w-7xl mt-12 w-full">
			<ContentClient client:idle>
				<BlogList slot="blogContentSlot" />
				<div slot="projectContentSlot">Under development</div>
			</ContentClient>
		</section>
	</main>
</Layout>
