---
import BlogList from '@/components/BlogList/BlogList.astro';
import ContentClient from '@/components/ContentClient';
import HeroContentWrapper from '@/components/HeroContentWrapper';
import ProjectsList from '@/components/ProjectsList/ProjectsList.astro';
import TerminalHero from '@/components/TerminalHero';
import { seoDefaults } from '@/lib/seo';
import { heroCardContent } from '@/lib/siteContent';
import HeroCard from '../components/Card/HeroCard.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
const { title, description, socials, techstack } = heroCardContent;
---

<Layout
	title="Portfólio | Vitor Hugo"
	description={description}
	ogImage="/og/institucional-v3.png"
	ogImageAlt={seoDefaults.ogImageAlt}
>
	<main class="flex items-center flex-col h-full w-full">
		<!-- Hero -->
		<section class="flex-center h-full w-full max-w-7xl p-2 md:p-0">
			<HeroContentWrapper client:load>
				<HeroCard
					slot="CardHeroSlot"
					title={title}
					description={description}
					socials={socials}
					techstack={techstack}
				/>

				<TerminalHero slot="TerminalSlot" client:load />
			</HeroContentWrapper>
		</section>

		<!-- Content Section -->
		<section class="flex-center max-w-7xl mt-10 md:mt-16 w-full">
			<ContentClient client:idle>
				<BlogList slot="blogContentSlot" />
				<ProjectsList slot="projectContentSlot" />
			</ContentClient>
		</section>
	</main>
</Layout>
