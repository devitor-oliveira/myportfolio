---
import DockNav from "@/components/DockNav";
import Footer from "@/components/Footer/Footer.astro";

import TagList from "@/components/ui/TagList";
import ProjectLayout from "@/layouts/ProjectLayout.astro";

import { formatDate } from "@/lib/utils";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const projects = await getCollection("projects");

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}
// Pega a prop enviada pelo getStaticPaths
const { project } = Astro.props;
// Renderiza o markdown transformando em componente HTML
const { Content } = await render(project);
---

<ProjectLayout title={project.data.title}>
	<article class="h-full w-full mx-auto max-w-3xl px-4 md:px-4 py-2">
		<nav class="fixed inset-x-0 bottom-6 z-50 flex w-full justify-center">
			<DockNav client:load />
		</nav>
		<header id="top" class="flex flex-col gap-3 w-full">
			<span class="flex items-center gap-1">
				<Icon name="mdi:circle" class="w-2 h-2 text-primary" />
				<p class="text-caption font-detail text-primary">
					{project.data.type}
				</p>
			</span>
			<h2 class="font-display text-h3 md:text-[1.75rem] text-text-main/85">
				{project.data.title}
			</h2>

			<p class="text-body-sm md:text-body text-text-main/80">
				{project.data.description}
			</p>

			<div class="flex flex-col gap-3 mt-4 md:mt-0">
				{/* Linha 1: data + links — altura fixa, nunca reflui */}
				<div class="flex items-center justify-between gap-4">
					<span class="flex gap-4">
						<time
							class="text-body-sm uppercase text-on-surface-variant leading-6 shrink-0"
						>
							{formatDate(project.data.year, false, false)}
						</time>
						{
							project.data.yearEnd ? (
								<span>/</span>
								<time class="text-body-sm uppercase text-on-surface-variant leading-6 shrink-0">
									{formatDate(project.data.yearEnd, false, false)}
								</time>
							) : null
						}
					</span>

					<div class="flex items-center gap-4 shrink-0">
						{
							project.data.liveURL && (
								<a
									href={project.data.liveURL}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center gap-1.5 leading-6 text-caption md:text-body-sm text-on-surface-variant transition-colors hover:text-on-surface"
								>
									Visite o site
									<Icon name="mdi:open-in-new" class="w-4 h-4 text-primary" />
								</a>
							)
						}
						{
							project.data.repositoryURL && (
								<a
									href={project.data.repositoryURL}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center gap-1.5 text-caption md:text-body-sm text-on-surface-variant transition-colors hover:text-on-surface"
								>
									Repositório
									<Icon name="mdi:open-in-new" class="w-4 h-4 text-primary" />
								</a>
							)
						}
					</div>
				</div>

				{/* Linha 2: tags — isolada, pode crescer sem afetar a linha acima */}
				<TagList
					client:visible
					tags={project.data.tags as string[]}
					className="uppercase tracking-wide"
				/>
			</div>
		</header>

		<div
			class="mt-8 md:mt-6 mb-10 md:mb-12 flex items-center gap-4 text-xs font-medium text-secondary font-detail"
		>
			<div class="h-px flex-1 bg-surface-tint/80"></div>

			<span class="text-surface-tint">•</span>

			<span class="text-surface-tint">•</span>
			<div class="h-px flex-1 bg-surface-tint/80"></div>
		</div>
		<main
			class="prose prose-sm md:prose-base md:prose-h1:text-[2rem] prose-invert prose-headings:text-text-main/90 max-w-none min-w-0 overflow-hidden text-text-main/80 font-body prose-strong:text-text-main/90 text-justify"
		>
			<Content />
		</main>
		<div
			class="mt-10 md:mt-14 mb-8 md:mb-6 flex items-center gap-4 text-xs font-medium text-secondary font-detail"
		>
			<div class="h-px flex-1 bg-surface-tint/80"></div>

			<span class="text-surface-tint">•</span>
			<span class="text-surface-tint font-detail italic">Fim</span>

			<span class="text-surface-tint">•</span>
			<div class="h-px flex-1 bg-surface-tint/80"></div>
		</div>

		<p class="text-body text-text-main/95">
			Precisa de uma solução? Entre em contato!
		</p>

		<Footer />
	</article>
</ProjectLayout>
