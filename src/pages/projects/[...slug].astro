---
import DockNav from "@/components/DockNav";
import SocialLink from "@/components/ui/SocialLink";
import TagList from "@/components/ui/TagList";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import { SocialLinks } from "@/lib/siteContent";
import { formatDate } from "@/lib/utils";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const projects = await getCollection("projects");

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}
// Pega a prop enviada pelo getStaticPaths
const { project } = Astro.props;
// Renderiza o markdown transformando em componente HTML
const { Content } = await render(project);

const footerSocials = ["linkedin", "email"];
---

<ProjectLayout title={project.data.title}>
	<article class="h-full w-full mx-auto max-w-3xl px-4 md:px-4 py-2">
		<nav class="fixed inset-x-0 bottom-6 z-50 flex w-full justify-center">
			<DockNav client:load />
		</nav>
		<header id="top" class="flex flex-col gap-4 w-full">
			<span class="flex items-center gap-1">
				<Icon name="mdi:circle" class="w-2 h-2 text-primary" />
				<p class="text-caption font-detail text-primary">
					{project.data.type}
				</p>
			</span>
			<h2 class="font-display text-h2 md:text-[1.75rem] text-text-main/85">
				{project.data.title}
			</h2>

			<p class="text-body text-text-main/80">
				{project.data.description}
			</p>
			<div class="grid grid-cols-[1fr_auto] gap-6 items-start">
				<div class="grid grid-rows-2 gap-1 min-w-0">
					<time
						class="text-body-sm uppercase text-on-surface-variant leading-6"
					>
						{formatDate(project.data.year, false, false)}
					</time>
					<TagList
						client:visible
						tags={project.data.tags as string[]}
						className="leading-6 uppercase tracking-wide"
					/>
				</div>

				<div class="grid grid-rows-2 gap-1 text-right shrink-0">
					{
						project.data.liveURL && (
							<a
								href={project.data.liveURL}
								target="_blank"
								rel="noopener noreferrer"
								class="flex items-center justify-end gap-1.5 leading-6 text-body-sm text-on-surface-variant transition-colors hover:text-on-surface"
							>
								Visite o site
								<Icon name="mdi:arrow-top-right" class="w-3 h-3 text-primary" />
							</a>
						)
					}
					{
						project.data.repositoryURL && (
							<a
								href={project.data.repositoryURL}
								target="_blank"
								rel="noopener noreferrer"
								class="flex items-center justify-end gap-1.5 leading-6 text-body-sm text-on-surface-variant transition-colors hover:text-on-surface"
							>
								Repositório
								<Icon name="mdi:arrow-top-right" class="w-3 h-3 text-primary" />
							</a>
						)
					}
				</div>
			</div>
		</header>
		<div
			class="mt-12 md:mt-6 mb-14 md:mb-12 flex items-center gap-4 text-xs font-medium text-secondary font-detail"
		>
			<div class="h-px flex-1 bg-surface-tint/80"></div>

			<span class="text-surface-tint">•</span>

			<span class="text-surface-tint">•</span>
			<div class="h-px flex-1 bg-surface-tint/80"></div>
		</div>
		<main
			class="prose prose-sm md:prose-base md:prose-h1:text-[2rem] prose-invert prose-headings:text-text-main/90 max-w-none min-w-0 overflow-hidden text-text-main/80 font-body prose-strong:text-text-main/90 text-justify"
		>
			<Content />
		</main>
		<div
			class="mt-12 md:mt-14 mb-14 md:mb-6 flex items-center gap-4 text-xs font-medium text-secondary font-detail"
		>
			<div class="h-px flex-1 bg-surface-tint/80"></div>

			<span class="text-surface-tint">•</span>
			<span class="text-surface-tint font-detail italic">Fim</span>

			<span class="text-surface-tint">•</span>
			<div class="h-px flex-1 bg-surface-tint/80"></div>
		</div>
		<footer class="w-full">
			<div>
				<span class="flex flex-col gap-1.5 text-start">
					<p class="text-body-sm text-text-main/90">
						Precisa de uma solução? Entre em contato!
					</p>
					{
						footerSocials && (
							<div id="footerSocials" class="flex gap-5 md:gap-8">
								{footerSocials.map((socialKey) => {
									const socialDataList = SocialLinks[socialKey];
									const socialItem = socialDataList && socialDataList[0];

									return socialItem && socialItem.link ? (
										<SocialLink
											client:load
											social={socialItem}
											socialName={socialKey}
										/>
									) : null;
								})}
							</div>
						)
					}
				</span>
				<hr class="border-border-muted-alt my-8" />
				<span
					class="flex justify-between items-center font-detail text-caption"
				>
					<p>© 2026 • Vitor Hugo</p>
					<a href="mailto:contato.dev@gmail.com">contato.dev@gmail.com</a>
					<p>
						<a href="">Termos</a>
						<i>•</i>
						<a href="">Privacidade</a>
					</p>
				</span>
			</div>
		</footer>
	</article>
</ProjectLayout>
