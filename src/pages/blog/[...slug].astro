---
import DockNav from "@/components/DockNav";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { formatDate } from "@/lib/utils";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("blog");

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

// Pega a prop enviada pelo getStaticPaths
const { post } = Astro.props;

// Renderiza o markdown transformando em componente HTML
const { Content } = await render(post);
---

<BlogLayout title={post.data.title}>
	<article class="h-full w-full mx-auto max-w-4xl px-2 md:px-4 py-2 mt-12">
		<nav class="fixed inset-x-0 bottom-20 z-50 flex w-full justify-center">
			<DockNav client:load />
		</nav>
		<header id="top" class="flex flex-col gap-4 w-full">
			<span class="flex items-center gap-1">
				<Icon name="mdi:circle" class="w-2 h-2 text-primary" />
				<p class="text-caption font-detail text-primary">{post.data.topic}</p>
			</span>
			<h2 class="font-display text-h2 md:text-[1.75rem] text-text-main/85">
				{post.data.title}
			</h2>

			<p class="text-body-sm text-text-main/80 tracking-wide">
				{post.data.description}
			</p>
		</header>
		<div
			class="mt-10 md:mt-14 mb-16 md:mb-20 flex items-center gap-4 text-xs font-medium text-secondary font-detail"
		>
			<div class="h-px flex-1 bg-surface-tint/80"></div>
			<span>Por {post.data.author}</span>
			<span class="text-surface-tint">•</span>
			<time>{formatDate(post.data.date, true)}</time>
			<span class="text-surface-tint">•</span>
			<span>5 min</span>
			<div class="h-px flex-1 bg-surface-tint/80"></div>
		</div>
		<main
			class="prose prose-sm md:prose-base md:prose-h1:text-[2rem] prose-invert prose-headings:text-text-main/90 max-w-none min-w-0 overflow-hidden text-text-main/80 font-body prose-strong:text-text-main/90"
		>
			<Content />
		</main>
		<footer id="down" class="w-full flex flex-wrap mb-30">
			{post.data.tags?.map((tag: string) => <span>{tag}</span>)}
		</footer>
	</article>
</BlogLayout>
