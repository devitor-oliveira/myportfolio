---
import SocialLink, { type socialItem } from "../ui/SocialLink";
import { Icon } from "astro-icon/components";
export interface CardProps {
	title: string;
	description: string;
	techstack?: string[];
	socials?: string[];
}

const { title, description, socials, techstack } = Astro.props as CardProps;

const SocialLinks: Record<string, socialItem[]> = {
	linkedin: [
		{
			icon: "ic:baseline-share",
			link: "https://www.linkedin.com/in/vitor-oliveira-0a1b2b1a3/",
			tooltipValue: "Perfil Profissional",
		},
	],
	github: [
		{
			icon: "ic:round-terminal",
			link: "https://github.com/devitor-oliveira",
			tooltipValue: "Meus Projetos",
		},
	],
	discord: [
		{
			icon: "mdi:chat-bubble-outline",
			link: "https://discord.gg/VHbfhkCSA",
			tooltipValue: "Meu servidor no discord",
		},
	],
};
---

<style>
	@reference "../../styles/global.css";
	.hero-card {
		@apply flex w-full justify-evenly flex-col p-4 md:p-6;
	}
	:global([data-active-tab="card"]) .hero-card {
		@apply justify-evenly max-w-150 mx-auto;

		/* #desc {
			@apply text-lg;
		} */
		#socials {
			@apply md:mt-0;
		}
		#socials a {
			@apply text-body;
		}
	}
</style>

<div class="flex bg-surface-dim h-full">
	<div class="hero-card">
		<div class="flex flex-col gap-4">
			<span class="flex text-brand-hover text-detail font-detail">
				<Icon name="ic:outline-keyboard-arrow-right" class="w-4 h-4" />
				<p class="tracking-widest">whoami</p>
			</span>
			<span
				class="flex items-center gap-2 text-secondary/85 text-xs font-detail"
			>
				<Icon name="mdi:circle" class="w-2 h-2 text-success" />
				<p class="tracking-wide">Vitor Hugo · online</p>
			</span>
			<div class="flex flex-col gap-3 mt-2">
				<h1
					class="text-lead tracking-wide font-bold font-display text-text-main/85"
				>
					{title}
				</h1>
				<p
					id="desc"
					class="text-text-muted text-sm md:text-body-sm font-body text-justify"
				>
					{description}
				</p>
			</div>
		</div>
		<div class="flex mt-2 gap-1.5 flex-wrap md:mt-3">
			{
				techstack?.map((stack) => {
					return (
						<p class="text-text-muted hover:text-primary text-detail md:text-caption font-detail">
							{techstack.lastIndexOf(stack) === techstack.length - 1
								? stack
								: `${stack} ·`}
						</p>
					);
				})
			}
		</div>
		<hr class="border-inverse-on-surface" />

		{
			socials && (
				<div id="socials" class="flex gap-5 md:gap-8">
					{socials.map((socialKey) => {
						const socialDataList = SocialLinks[socialKey];
						const socialItem = socialDataList && socialDataList[0];

						return socialItem && socialItem.link ? (
							<SocialLink
								client:load
								social={socialItem}
								socialName={socialKey}
							/>
						) : null;
					})}
				</div>
			)
		}

		<span class="text-primary/80 tracking-wide text-detail font-detail">
			Digite /sobre no terminal para saber mais...
		</span>
	</div>
</div>
