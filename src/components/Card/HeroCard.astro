---
import SocialLink, { type socialItem } from "../ui/SocialLink";
import { Icon } from "astro-icon/components";
interface CardProps {
	title: string;
	description: string;
	image?: string;
	socials?: string[];
}

const { title, description, socials } = Astro.props as CardProps;

const SocialLinks: Record<string, socialItem[]> = {
	linkedin: [
		{
			icon: "ic:baseline-share",
			link: "https://www.linkedin.com/in/vitor-oliveira-0a1b2b1a3/",
			tooltipValue: "Perfil Profissional",
		},
	],
	github: [
		{
			icon: "ic:round-terminal",
			link: "https://github.com/devitor-oliveira",
			tooltipValue: "Meus Projetos",
		},
	],
	discord: [
		{
			icon: "mdi:chat-bubble-outline",
			link: "https://discord.gg/VHbfhkCSA",
			tooltipValue: "Meu servidor no discord",
		},
	],
};
---

<div class="flex bg-surface-dim h-full">
	<div class="flex justify-around flex-col p-6">
		<div class="flex flex-col gap-4">
			<span
				class="flex items-center gap-2 text-brand-primary text-xs font-detail"
			>
				<Icon name="mdi:circle" class="w-2 h-2" />
				<p class="uppercase tracking-widest">Vitor Hugo</p>
			</span>
			<h1 class="text-hero leading-tight font-bold font-display text-text-main">
				{title}
			</h1>
			<p class="text-text-muted text-body font-body mt-4">{description}</p>
		</div>
		{
			socials && (
				<div class="flex gap-8 mt-4">
					{socials.map((socialKey) => {
						const socialDataList = SocialLinks[socialKey];
						const socialItem = socialDataList && socialDataList[0];

						return socialItem && socialItem.link ? (
							<SocialLink
								client:load
								social={socialItem}
								socialName={socialKey}
							/>
						) : null;
					})}
				</div>
			)
		}
	</div>
</div>
