---
import SocialLink, { type socialItem } from "../ui/SocialLink";

interface CardProps {
	title: string;
	description: string;
	image?: string;
	socials?: string[];
}

const { title, description, socials } = Astro.props as CardProps;

const SocialLinks: Record<string, socialItem[]> = {
	linkedin: [
		{
			icon: "mdi:linkedin",
			link: "https://www.linkedin.com/in/vitor-oliveira-0a1b2b1a3/",
			tooltipValue: "Perfil Profissional",
		},
	],
	github: [
		{
			icon: "mdi:github",
			link: "https://github.com/devitor-oliveira",
			tooltipValue: "Meus Projetos",
		},
	],
	discord: [
		{
			icon: "ic:baseline-discord",
			link: "https://discord.gg/VHbfhkCSA",
			tooltipValue: "Meu servidor no discord",
		},
	],
};
---

<div class="flex bg-surface-dim">
	<div class="flex justify-around flex-col gap-4 p-4">
		<div class="flex flex-col gap-4">
			<h2 class="text-hero leading-tight font-bold font-display">
				{title}
			</h2>
			<p class="text-text-muted text-body">{description}</p>
		</div>
		{
			socials && (
				<div class="flex  gap-4 mt-4">
					{socials.map((socialKey) => {
						const socialDataList = SocialLinks[socialKey];
						const socialItem = socialDataList && socialDataList[0];

						return socialItem && socialItem.link ? (
							<SocialLink
								client:load
								social={socialItem}
								socialName={socialKey}
							/>
						) : null;
					})}
				</div>
			)
		}
	</div>
</div>
