---
import { publicDir, root } from 'astro:config/server';
import { getSEOImageMetadata } from '@/lib/ogImage';
import type { SEOProps } from '@/lib/seo';
import { seoDefaults, seoMetadataSchema } from '@/lib/seo';

interface Props extends SEOProps {}

const {
	title = seoDefaults.title,
	description = seoDefaults.description,
	type = 'website',
	author,
	article,
	noindex = false,
} = Astro.props;

if (!Astro.site)
	throw new Error('Configure site no astro.config.mjs para SEO.');
const parsed = seoMetadataSchema.parse(Astro.props);

// Títulos e descrições separados para SERP (Google) e Social (Open Graph/Twitter)
const searchTitle = parsed.metaTitle ?? parsed.seoTitle ?? title;
const searchDescription =
	parsed.metaDescription ?? parsed.seoDescription ?? description;

const socialTitle =
	parsed.ogTitle ?? parsed.metaTitle ?? parsed.seoTitle ?? title;
const socialDescription =
	parsed.ogDescription ??
	parsed.metaDescription ??
	parsed.seoDescription ??
	description;

// en_US é a convenção editorial para inglês, não a nacionalidade do autor.
const locale =
	parsed.ogLocale ?? (parsed.language === 'en' ? 'en_US' : 'pt_BR');
// trailingSlash permanece no padrão ignore: preservar o pathname da rota.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagePath = parsed.ogImage ?? seoDefaults.ogImage;
const imageAlt = parsed.ogImageAlt ?? seoDefaults.ogImageAlt;
const imageURL = new URL(imagePath, Astro.site);
const image = await getSEOImageMetadata(imagePath, new URL(publicDir, root));
const articleAuthor = article?.authorURL
	? new URL(article.authorURL, Astro.site)
	: undefined;
---

<title>{searchTitle}</title>
<meta name="description" content={searchDescription} />
{
	noindex ? (
		<meta name="robots" content="noindex, nofollow" />
	) : (
		<meta name="robots" content="index, follow, max-image-preview:large" />
	)
}
<link rel="canonical" href={canonical.href} />
{author && <meta name="author" content={author} />}
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={socialDescription} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={seoDefaults.siteName} />
<meta property="og:locale" content={locale} />
<meta property="og:image" content={imageURL.href} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:type" content={image.type} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={socialDescription} />
<meta name="twitter:image" content={imageURL.href} />
<meta name="twitter:image:alt" content={imageAlt} />
{
	type === "article" && (
		<>
			{article?.publishedTime && (
				<meta
					property="article:published_time"
					content={article.publishedTime.toISOString()}
				/>
			)}
			{articleAuthor && (
				<meta property="article:author" content={articleAuthor.href} />
			)}
			{article?.section && (
				<meta property="article:section" content={article.section} />
			)}
			{article?.tags?.map((tag) => (
				<meta property="article:tag" content={tag} />
			))}
		</>
	)
}
