---
import { getCollection } from "astro:content";
import { formatDate } from "@/lib/utils";
import ProjectCard from "../ProjectCard/ProjectCard.astro";

const projects = await getCollection("projects");
---

<main class="max-w-3xl w-full gap-16 flex-center flex-col p-2">
	{
		projects.map((project, index) => {
			let end = project.data.yearEnd
				? formatDate(project.data.yearEnd, false, true)
				: null;
			return (
				<ProjectCard
					slug={project.id}
					type={project.data.type}
					title={project.data.title}
					description={project.data.description}
					year={formatDate(project.data.year, false, true)}
					yearEnd={end}
					tags={project.data.tags}
					liveURL={project.data.liveURL}
					repositoryURL={project.data.repositoryURL}
					class="animate-fade-up animate-once animate-duration-500 animate-ease-out"
					style={`animation-delay: ${index * 100}ms`}
				/>
			);
		})
	}
</main>
