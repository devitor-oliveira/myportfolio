---
import { getCollection } from "astro:content";
import { formatDate } from "@/lib/utils";
import BlogCard from "../BlogCard/BlogCard.astro";

const posts = await getCollection("blog");
---

<main class="max-w-2xl w-full gap-6 flex-center flex-col p-0 md:p-1">
	{
		posts.map((post, index) => {
			return (
				<BlogCard
					slug={post.id}
					title={post.data.title}
					shortDesc={post.data.description}
					date={formatDate(post.data.date)}
					topic={post.data.topic}
					tags={post.data.tags}
					class="animate-fade-up animate-once animate-duration-500 animate-ease-out"
					style={`animation-delay: ${index * 100}ms`}
				/>
			);
		})
	}
</main>
