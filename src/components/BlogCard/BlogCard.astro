---
import TagList from "../ui/TagList";

interface BlogCardProps {
	slug: string;
	author?: string;
	title: string;
	shortDesc: string;
	date: string;
	topic?: string;
	tags?: string[];
}

const { title, slug, shortDesc, date, topic, tags } =
	Astro.props as BlogCardProps;
---

<article
	class="group w-full h-full cursor-pointer py-4 px-6 bg-surface-dim
  hover:bg-surface-container-low flex flex-col gap-2 border border-border-muted-alt hover:border-primary-container transition-colors"
>
	<!-- ASsunto + data -->
	<header
		class="flex font-detail tracking-wider justify-between w-full transition-colors"
	>
		{
			topic ? (
				<span class="uppercase text-[10px] group-hover:text-brand-primary text-text-muted/85">
					[{topic}]
				</span>
			) : null
		}
		{
			date ? (
				<time
					class=" group-hover:text-brand-primary text-[10px] text-text-muted/85 uppercase"
					datetime={date}
				>
					{date}
				</time>
			) : null
		}
	</header>
	<!-- corpo: titulo + descrição -->
	<div class="flex flex-col gap-3">
		<a href={`/blog/${slug}`} target="_blank" class="w-fit flex flex-col gap-2">
			<h3 class="font-display text-text-main/85 text-lead md:text-[18px]">
				{title}
			</h3>
			<p
				class="text-text-main/80 text-caption tracking-wide md:tracking-normal md:text-sm"
			>
				{shortDesc}
			</p>
		</a>
	</div>

	<!-- Footer: tags -->
	<aside class="flex flex-wrap pt-4 mt-2 border-t border-border-muted-alt">
		<TagList
			className="text-text-main/80 capitalize font-body"
			client:visible
			tags={tags as string[]}
			max={6}
		/>
	</aside>
</article>
