---
import ClickSpark from "@/components/ui/clickspark";
import "../styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" initial-scale="1.0" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Blog | {Astro.props.title}</title>
	</head>

	<body class="min-h-screen py-12 mb-16 w-full mx-auto font-body bg-surface">
		<ClickSpark
			sparkSize={8}
			sparkRadius={15}
			duration={400}
			sparkCount={8}
			client:load
		>
			<slot />
		</ClickSpark>
	</body>
</html>
