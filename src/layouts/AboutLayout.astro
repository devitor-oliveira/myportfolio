---
import Footer from "@/components/Footer/Footer.astro";
import "../styles/global.css";
import ClickSpark from "@/components/ui/clickspark";
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" initial-scale="1.0" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Sobre | Vitor</title>
	</head>

	<body
		class="min-h-screen pt-26 pb-12 md:px-4 p-2.5 mx-auto w-full h-full font-body max-w-2xl"
	>
		<ClickSpark
			sparkSize={8}
			sparkRadius={15}
			duration={400}
			sparkCount={8}
			client:load
		>
			<slot />
			<Footer />
		</ClickSpark>
	</body>
</html>
